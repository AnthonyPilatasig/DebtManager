<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DebtManager.Frontend.ViewModels"
             xmlns:api="using:DebtManager.Frontend.Api"
             x:Class="DebtManager.Frontend.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
             
    <ScrollViewer>
        <StackPanel Spacing="24" Margin="0,0,0,40">
            <!-- Header -->
            <TextBlock Text="Resumen Financiero" FontSize="32" FontWeight="Bold" Foreground="White" />
            
            <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                <!-- Flujo de Caja Libre Card -->
                <ExperimentalAcrylicBorder Classes="Card" Margin="0,0,12,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Flujo de Caja Libre" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding FreeCashFlow, StringFormat='{}{0:C}'}" FontSize="36" FontWeight="ExtraBold" Foreground="White"/>
                        <TextBlock Text="Dinero disponible mes a mes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ExperimentalAcrylicBorder>
                
                <!-- Deuda Total Card -->
                <ExperimentalAcrylicBorder Classes="Card" Margin="12,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Deuda Total Activa" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalDebt, StringFormat='{}{0:C}'}" FontSize="36" FontWeight="ExtraBold" Foreground="White"/>
                        <TextBlock Text="Suma de todos tus saldos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ExperimentalAcrylicBorder>
            </UniformGrid>

            <!-- Semáforo de Riesgo -->
            <ExperimentalAcrylicBorder Classes="Card">
                <Grid ColumnDefinitions="Auto, *">
                    <Ellipse Grid.Column="0" Width="64" Height="64" Fill="{Binding RiskColor}" Margin="0,0,24,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Nivel de Riesgo Actual" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding RiskLevel}" FontSize="28" FontWeight="Black" Foreground="{Binding RiskColor}"/>
                    </StackPanel>
                </Grid>
            </ExperimentalAcrylicBorder>
            
            <!-- Formulario de Registro de Ingresos -->
            <ExperimentalAcrylicBorder Classes="Card">
                <StackPanel Spacing="16">
                    <TextBlock Text="Registrar Ingreso (Sueldo)" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel Margin="0,0,16,16" Width="200">
                            <TextBlock Text="Nombre de la Fuente" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,0,0,4"/>
                            <TextBox Text="{Binding NewIncomeName}" PlaceholderText="Ej: Sueldo, Rentas" CornerRadius="8"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,16,16" Width="160">
                            <TextBlock Text="Monto Mensual" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="4,0,0,4"/>
                            <NumericUpDown Value="{Binding NewIncomeAmount}" Minimum="0" FormatString="C2" CornerRadius="8"/>
                        </StackPanel>

                        <Button Content="Registrar Ingreso" Command="{Binding AddIncomeCommand}" Background="{StaticResource PrimaryBrush}" Foreground="White" CornerRadius="8" Padding="16,8" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
                    </WrapPanel>
                </StackPanel>
            </ExperimentalAcrylicBorder>
            
            <!-- Lista de Ingresos Activos -->
            <TextBlock Text="Tus Ingresos Activos" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding Incomes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="api:IncomeDto">
                        <ExperimentalAcrylicBorder Classes="Card" Margin="0,0,0,12" Padding="16">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                                    <TextBlock Text="{Binding Amount, StringFormat='Monto: {0:C}'}" FontSize="16" Foreground="White"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2" 
                                        Content="Eliminar" 
                                        Command="{ReflectionBinding $parent[UserControl].DataContext.DeleteIncomeCommand}"
                                        CommandParameter="{Binding Id}"
                                        Background="{StaticResource CriticalBrush}" Foreground="White" 
                                        VerticalAlignment="Center" CornerRadius="8" Padding="12,8"/>
                            </Grid>
                        </ExperimentalAcrylicBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Button Content="Actualizar Datos" Command="{Binding LoadDashboardDataCommand}" HorizontalAlignment="Right" Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="16,8" CornerRadius="8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
